{
  // Site tĩnh (Next.js `output: "export"`) -> chỉ upload thư mục `out/` làm static assets.
  // Không dùng OpenNext vì project không có server-side rendering.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-planner",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
